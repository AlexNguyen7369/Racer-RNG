local old = StarterGui:FindFirstChild("RacerHud")
if old then
	old:Destroy()
end
local refs = build(StarterGui)
local count = #refs.Gui:GetDescendants()
return "built RacerHud in StarterGui: " .. count .. " instances, spec e45f06c655d8"
